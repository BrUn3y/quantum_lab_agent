# --- IBM QUANTUM CREDENTIALS ---
# Get your token at: https://quantum.cloud.ibm.com/
QISKIT_IBM_TOKEN=your_ibm_quantum_token_here

# --- WATSONX CONFIGURATION ---
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat?version=2023-05-29

# --- MODEL PROVIDER CONFIGURATION ---
# Provider-qualified BeeAI names. These override the legacy WATSONX_* variables below.
# Start Ollama and run: ollama pull granite4.2:8b
OLLAMA_API_BASE=http://127.0.0.1:11434
DEVELOPER_MODEL=ollama:granite4.2:8b
STATUS_MODEL=ollama:granite4.2:8b
COMPUTING_MODEL=ollama:granite4.2:8b
EXPERIMENT_MODEL=ollama:granite4.2:8b
LAB_MODEL=ollama:granite4.2:8b

# --- QUANTUM DEVELOPER AGENT (Port 8001) ---
# Expert in Qiskit and OpenQASM code generation
# Uses the configured Granite model for code generation
WATSONX_DEVELOPER_MODEL=mistralai/mistral-large-2
DEVELOPER_HOST=127.0.0.1
DEVELOPER_PORT=8001

# --- QUANTUM STATUS AGENT (Port 8002) ---
# Specialist in quantum computer status and job queries
# Valid options: mistralai/mistral-large-2, mistralai/mistral-small, mistralai/mistral-7b-instruct-v0-3
WATSONX_STATUS_MODEL=mistralai/mistral-large-2
STATUS_HOST=127.0.0.1
STATUS_PORT=8002

# --- QUANTUM COMPUTING AGENT (Port 8003) ---
# Specialist in quantum circuit execution on IBM Quantum
# Valid options: mistralai/mistral-large-2, mistralai/mistral-small, mistralai/mistral-7b-instruct-v0-3
WATSONX_COMPUTING_MODEL=mistralai/mistral-large-2
COMPUTING_HOST=127.0.0.1
COMPUTING_PORT=8003

# --- QUANTUM EXPERIMENT AGENT (Port 8004, Development) ---
# Hybrid QAOA/VQE experiment design, optimization, and validation
WATSONX_EXPERIMENT_MODEL=mistralai/mistral-large-2
EXPERIMENT_HOST=127.0.0.1
EXPERIMENT_PORT=8004

# --- QUANTUM LAB AGENT (Port 8000) ---
# Main orchestrator managing Developer, Status, and Computing Agents
# Valid options: mistralai/mistral-large-2, mistralai/mistral-small, mistralai/mistral-7b-instruct-v0-3
WATSONX_LAB_MODEL=mistralai/mistral-large-2
LAB_HOST=127.0.0.1
LAB_PORT=8000

# --- GENERAL SETTINGS ---
LOG_LEVEL=info
