# --- IBM QUANTUM CREDENTIALS ---
# Consigue tu token en: https://quantum.cloud.ibm.com/
QISKIT_IBM_TOKEN=your_ibm_quantum_token_here

# --- WATSONX CONFIGURATION ---
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat?version=2023-05-29

# --- QUANTUM DEVELOPER AGENT (Puerto 8001) ---
# Experto en generación de código Qiskit y OpenQASM
# Usa Mistral Large para mejor generación de código
WATSONX_DEVELOPER_MODEL=mistralai/mistral-large-2
DEVELOPER_HOST=127.0.0.1
DEVELOPER_PORT=8001

# --- QUANTUM STATUS AGENT (Puerto 8002) ---
# Especialista en consultas de estado de computadoras cuánticas y trabajos
# Opciones válidas: mistralai/mistral-large-2, mistralai/mistral-small, mistralai/mistral-7b-instruct-v0-3
WATSONX_STATUS_MODEL=mistralai/mistral-large-2
STATUS_HOST=127.0.0.1
STATUS_PORT=8002

# --- QUANTUM COMPUTING AGENT (Puerto 8003) ---
# Especialista en ejecución de circuitos cuánticos en IBM Quantum
# Opciones válidas: mistralai/mistral-large-2, mistralai/mistral-small, mistralai/mistral-7b-instruct-v0-3
WATSONX_COMPUTING_MODEL=mistralai/mistral-large-2
COMPUTING_HOST=127.0.0.1
COMPUTING_PORT=8003

# --- QUANTUM OPERATIONS AGENT (Puerto 8000) ---
# Orquestador principal que coordina Developer, Status y Computing Agents
# Opciones válidas: mistralai/mistral-large-2, mistralai/mistral-small, mistralai/mistral-7b-instruct-v0-3
WATSONX_OPERATIONS_MODEL=mistralai/mistral-large-2
OPERATIONS_HOST=127.0.0.1
OPERATIONS_PORT=8000

# --- GENERAL SETTINGS ---
LOG_LEVEL=info